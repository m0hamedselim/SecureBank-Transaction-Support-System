        private void ConnectToServer()
        {
            try
            {
                tcpClientSocket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
                tcpClientSocket.Connect(new IPEndPoint(IPAddress.Parse(SERVER_IP), TCP_PORT));

                byte[] initBuffer = new byte[1024];
                int bytesRead = tcpClientSocket.Receive(initBuffer);
                string serverGreeting = Encoding.ASCII.GetString(initBuffer, 0, bytesRead);

                if (lblAuthStatus != null)
                {
                    lblAuthStatus.Text = "Connected to server. " + serverGreeting.Trim();
                }
            }
            catch (Exception ex)
            {
                if (lblAuthStatus != null && btnLogin != null)
                {
                    lblAuthStatus.ForeColor = Color.Red;
                    lblAuthStatus.Text = "❌ Failed to link with backend server:\n" + ex.Message;
                    btnLogin.Enabled = false;
                }
            }
        }

        private async Task ExecuteLogin()
        {
            if (txtUsername == null || txtPassword == null || lblAuthStatus == null || lstLog == null || lblBalance == null || pnlAuth == null || pnlMainApp == null) return;

            string user = txtUsername.Text.Trim();
            string pass = txtPassword.Text.Trim();

            if (string.IsNullOrEmpty(user) || string.IsNullOrEmpty(pass))
            {
                lblAuthStatus.ForeColor = Color.OrangeRed;
                lblAuthStatus.Text = "⚠️ Please fill in both login fields!";
                return;
            }

            lblAuthStatus.ForeColor = Color.Navy;
            lblAuthStatus.Text = "Sending secure handshake challenge...";

            string loginCmd = $"LOGIN {user} {pass}";
            string response = await Task.Run(() => TalkToTcpSocket(loginCmd));

            if (response.StartsWith("AUTH_SUCCESS"))
            {
                pnlAuth.Visible = false;
                pnlMainApp.Visible = true;

                lstLog.Items.Add($"[{DateTime.Now:HH:mm:ss}] Secure handshake completed successfully.");
                lstLog.Items.Add($"[{DateTime.Now:HH:mm:ss}] Server: {response.Trim()}");

                lblBalance.Text = "Current Balance: $0.00";
            }
            else
            {
                lblAuthStatus.ForeColor = Color.Red;
                lblAuthStatus.Text = "❌ " + response;
            }
        }

        private async Task SendTcpCommand(string command)
        {
            if (lstLog == null || lblBalance == null || txtAmount == null || txtChat == null) return;

            string response = await Task.Run(() => TalkToTcpSocket(command));

            lstLog.Items.Add($"[{DateTime.Now:HH:mm:ss}] Sent: {command}");
            lstLog.Items.Add($"[{DateTime.Now:HH:mm:ss}] Reply: {response.Trim()}");
            lstLog.SelectedIndex = lstLog.Items.Count - 1; // التمرير التلقائي لآخر سطر

            if (response.Contains("Balance"))
            {
                string[] parts = response.Split(new[] { "Balance:" }, StringSplitOptions.None);
                if (parts.Length > 1)
                {
                    lblBalance.Text = $"Current Balance: {parts[1].Trim()}";
                }
                else if (response.Contains("Balance "))
                {
                    lblBalance.Text = $"Current Balance: {response.Split(new[] { "Balance " }, StringSplitOptions.None)[1].Trim()}";
                }
            }

            txtAmount.Clear();
            txtChat.Clear();
        }

        private string TalkToTcpSocket(string textToSend)
        {
            if (tcpClientSocket == null) return "ERROR: Socket not initialized.";
            try
            {
                byte[] data = Encoding.ASCII.GetBytes(textToSend);
                tcpClientSocket.Send(data);

                byte[] incomingBuffer = new byte[1024];
                int bytesReceived = tcpClientSocket.Receive(incomingBuffer);

                if (bytesReceived == 0)
                {
                    return "ERROR: Lost connection to backend server.";
                }

                return Encoding.ASCII.GetString(incomingBuffer, 0, bytesReceived);
            }
            catch (Exception ex)
            {
                return "SOCKET_ERROR: " + ex.Message;
            }
        }

        private void ExecuteUdpRequest()
        {
            if (lblUdpRates == null) return;

            Socket udpClientSocket = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, ProtocolType.Udp);
            IPEndPoint serverUdpEndPoint = new IPEndPoint(IPAddress.Parse(SERVER_IP), UDP_PORT);

            try
            {
                byte[] requestBytes = Encoding.ASCII.GetBytes("GET_RATES");
                udpClientSocket.SendTo(requestBytes, serverUdpEndPoint);

                byte[] incomingBuffer = new byte[1024];
                EndPoint remoteServerEndPoint = new IPEndPoint(IPAddress.Any, 0);

                int bytesReceived = udpClientSocket.ReceiveFrom(incomingBuffer, ref remoteServerEndPoint);
                string responseData = Encoding.ASCII.GetString(incomingBuffer, 0, bytesReceived);

                lblUdpRates.Text = responseData.Replace("TICKER_DATA:", "📈 ");
                lblUdpRates.ForeColor = Color.FromArgb(72, 187, 120);
            }
            catch (Exception ex)
            {
                lblUdpRates.Text = "⚠️ Failed to broadcast UDP query.";
                lblUdpRates.ForeColor = Color.FromArgb(245, 101, 101);
                Console.WriteLine(ex.Message);
            }
            finally
            {
                udpClientSocket.Close();
            }
        }

        private bool ValidateAmount()
        {
            if (txtAmount == null) return false;
            if (decimal.TryParse(txtAmount.Text, out decimal amt) && amt > 0)
            {
                return true;
            }
            MessageBox.Show("⚠️ Invalid numeric amount entered! Please write a valid positive number.", "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            return false;
        }

        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            if (tcpClientSocket != null && tcpClientSocket.Connected)
            {
                try
                {
                    tcpClientSocket.Shutdown(SocketShutdown.Both);
                }
                catch { }
                tcpClientSocket.Close();
            }
            base.OnFormClosing(e);
        }

